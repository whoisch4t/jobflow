generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Keep enum values in sync with packages/shared/src/enums.ts.

enum ApplicationStatus {
  WISHLIST
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum InterviewType {
  PHONE
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  TAKE_HOME
  ONSITE
  OTHER
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

enum OfferDecision {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  companies     Company[]
  applications  Application[]
  cvVersions    CvVersion[]
}

/// Refresh tokens are stored hashed. A token is used once, then replaced (rotation).
/// Tokens from the same login share a familyId so reuse of an old token can revoke the whole family.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Company {
  id        String   @id @default(cuid())
  userId    String
  name      String
  website   String?
  location  String?
  industry  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name])
}

model CvVersion {
  id          String   @id @default(cuid())
  userId      String
  name        String
  url         String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  companyId   String
  cvVersionId String?
  title       String
  status      ApplicationStatus @default(WISHLIST)
  jobUrl      String?
  location    String?
  workMode    WorkMode?
  source      String?
  salaryMin   Int?
  salaryMax   Int?
  currency    String?
  description String?
  appliedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cvVersion     CvVersion?     @relation(fields: [cvVersionId], references: [id], onDelete: SetNull)
  interviews    Interview[]
  offer         Offer?
  notes         Note[]
  statusHistory StatusChange[]

  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([companyId])
}

/// One row per status transition. Powers the timeline and the analytics.
model StatusChange {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
}

model Interview {
  id              String           @id @default(cuid())
  applicationId   String
  type            InterviewType
  scheduledAt     DateTime
  durationMinutes Int?
  interviewer     String?
  location        String?
  notes           String?
  outcome         InterviewOutcome @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
}

model Offer {
  id            String        @id @default(cuid())
  applicationId String        @unique
  salary        Int
  currency      String
  bonus         String?
  equity        String?
  benefits      String?
  startDate     DateTime?
  deadline      DateTime?
  decision      OfferDecision @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Note {
  id            String   @id @default(cuid())
  applicationId String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}
