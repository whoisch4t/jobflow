# Copy to .env and adjust. `npm run db:start` (repo root) serves this database without Docker.
DATABASE_URL="postgresql://jobflow:jobflow@localhost:5433/jobflow"

# Used by `npm test`. Tests wipe this database, never point it at real data.
TEST_DATABASE_URL="postgresql://jobflow:jobflow@localhost:5433/jobflow_test"

# Optional. Without it, rate limits and analytics cache live in memory.
# REDIS_URL="redis://localhost:6379"

PORT=4100
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters"

# Origin of the web app (for CORS in production setups where web and API run on different hosts).
WEB_ORIGIN="http://localhost:3100"

# Set to true when served over HTTPS so auth cookies get the Secure flag.
COOKIE_SECURE=false
